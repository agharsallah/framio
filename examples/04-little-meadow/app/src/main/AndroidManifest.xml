<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Parent dashboard: a small web server on the frame, found on the LAN through mDNS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Volume from the dashboard -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!--
      largeHeap: on Android 6 bitmaps live in the Java heap, and the frame's default limit is 80 MB.
      The sprite cache is bounded (see Sprites), this only gives it room next to Compose.
    -->
    <application
        android:name=".MeadowApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meadow"
        android:usesCleartextTraffic="true">

        <!-- singleTask: adb and the parent dashboard reach the running activity through onNewIntent -->
        <activity
            android:name=".MeadowActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- How the framio launcher (example 02) draws this app's tile -->
            <meta-data android:name="dev.framio.tile.subtitle" android:value="For little ones" />
            <meta-data android:name="dev.framio.tile.accent" android:value="#E7B05A" />
            <meta-data android:name="dev.framio.tile.order" android:value="50" />
        </activity>
    </application>
</manifest>
