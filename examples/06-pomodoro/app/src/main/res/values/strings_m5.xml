    <string name="settings_about_version">Pomodoro %1$s</string>
    <string name="settings_about_text">A focus timer that tries not to compete for your attention. The Pomodoro rhythm itself is only weakly supported by research: it is a useful structure, not a proven method. Breaks help you feel better more reliably than they help you produce more. Each feature says how strong its evidence is.</string>
    <string name="settings_about_why">Why? All the evidence</string>
    <string name="settings_claims">Claims this app won’t make</string>
    <string name="claim_proven">“Pomodoro is scientifically proven”: small studies, mixed results.</string>
    <string name="claim_5217">“52/17 is optimal”: folk wisdom.</string>
    <string name="claim_23">“It takes 23 minutes to refocus”: a misquote.</string>
    <string name="claim_90">“Work in 90-minute cycles”: not supported for waking work.</string>
    <string name="claim_willpower">“Willpower is a battery”: failed a 23-lab replication.</string>
    <string name="claim_phone">“Your phone’s mere presence drains you”: mostly fails to replicate.</string>
    <string name="claim_noise">“Brown noise or blue-light filters boost focus”: conflicting or no studies.</string>

    <!-- Why? -->
    <string name="why_moderate_strong">Moderate to strong evidence</string>
    <string name="why_sound_title">Sound is off unless you choose it</string>
    <string name="why_sound_evidence">Lyrics disrupt reading, and instrumental music has about no effect. White or pink noise helped people with ADHD a little (g = +.25) but hurt everyone else a little (g = −.21).</string>
    <string name="why_sound_source">Vasilev et al. 2018, Perspectives on Psychological Science · Nigg et al. 2024, JAACAP</string>
    <string name="why_sound_note">noise may help with ADHD and may hurt otherwise</string>
    <string name="why_evening_title">Warmer and dimmer in the evening</string>
    <string name="why_evening_evidence">Reading on a light-emitting screen in the evening delayed melatonin and made people less sleepy at bedtime than reading a printed book.</string>
    <string name="why_evening_source">Chang et al. 2015, PNAS</string>
    <string name="why_evening_note">the frame’s amber is a gentle step, not a sleep cure</string>
</resources>
