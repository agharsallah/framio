    <!-- M4: Why? -->
    <string name="why_title">Why? The evidence, honestly</string>
    <string name="why_open">Why? Show the evidence</string>
    <string name="why_strong">Strong evidence</string>
    <string name="why_moderate">Moderate evidence</string>
    <string name="why_moderate_weak">Moderate to weak evidence</string>
    <string name="why_weak">Weak evidence</string>
    <string name="why_strength_note">%1$s · %2$s</string>
    <string name="why_break_title">A break away from the screen</string>
    <string name="why_break_evidence">Short breaks reliably left people less tired and more vigorous, but barely changed how much they got done; spending the break on a phone led to fewer problems solved afterwards.</string>
    <string name="why_break_note">helps how you feel more than output</string>
    <string name="why_break_source">Albulescu et al. 2022, PLOS ONE (meta-analysis) · Kang &amp; Kurtzberg 2019</string>
    <string name="why_nature_title">A landscape, and a real window</string>
    <string name="why_nature_evidence">A 40-second view of a green roof improved attention in one study, and reviews find small to moderate benefits from nature, with real nature doing better than pictures of it.</string>
    <string name="why_nature_source">Lee et al. 2015 · Stevenson et al. 2018 (review)</string>
    <string name="why_batching_title">Messages in batches</string>
    <string name="why_batching_evidence">Checking messages in batches, about three times a day, lowered stress, while turning notifications off entirely raised anxiety.</string>
    <string name="why_batching_source">Fitz et al. 2019, Computers in Human Behavior</string>
    <string name="why_intention_title">Saying what you’ll work on</string>
    <string name="why_intention_evidence">Deciding what you will do, and what you’ll do if distracted (if-then), helped people follow through across hundreds of tests.</string>
    <string name="why_intention_source">Gollwitzer &amp; Sheeran 2006 · Sheeran et al. 2025 (d ≈ .27–.66)</string>
    <string name="why_phone_title">The phone, silenced</string>
    <string name="why_phone_evidence">Notifications pull attention even when you ignore them; the idea that a phone’s mere presence drains you mostly failed to replicate, so this is only a reminder.</string>
    <string name="why_phone_source">Stothart et al. 2015 · Ruiz Pardo &amp; Minda 2022</string>
    <string name="why_still_title">A dark, still screen</string>
    <string name="why_still_evidence">Interruptions of only 3 to 4 seconds doubled to tripled errors, so during focus the screen shows no seconds, no motion and nothing new.</string>
    <string name="why_still_source">Altmann, Trafton &amp; Hambrick 2014 · Stothart et al. 2015</string>
    <string name="why_tiers_title">Break length by how long you worked</string>
    <string name="why_tiers_evidence">Flowtime earns 5 minutes for up to 25 of work, 8 for up to 50 and 10 beyond; studies comparing it with fixed blocks found mostly no difference either way.</string>
    <string name="why_tiers_note">a useful structure, not a proven method</string>
    <string name="why_tiers_source">Smits et al. 2025 · Biwer et al. 2023 · Göksu et al. 2026</string>
